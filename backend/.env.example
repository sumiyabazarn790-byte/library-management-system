# Copy this file to backend/.env for local scripts, or load the same values into Supabase edge
# function secrets with `supabase secrets set --env-file backend/.env --workdir backend`.

OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_QUERY_MODEL=gpt-4.1-mini
# Optional: override the reader's English->Mongolian translation model
OPENAI_READER_TRANSLATE_MODEL=
# Optional for proxies or compatible gateways. Default: https://api.openai.com/v1
OPENAI_BASE_URL=

# QPay edge function secrets
# Use the sandbox URL only for testing. For real payments, set the live merchant base URL issued by QPay.
QPAY_BASE_URL=https://merchant-sandbox.qpay.mn/v2
QPAY_USERNAME=your-qpay-client-id
QPAY_PASSWORD=your-qpay-client-secret
QPAY_INVOICE_CODE=your-qpay-invoice-code
QPAY_INVOICE_RECEIVER_CODE=your-qpay-invoice-receiver-code

# Optional
QPAY_CALLBACK_URL=http://127.0.0.1:54321/functions/v1/qpay-borrow/callback
QPAY_BRANCH_CODE=
QPAY_TERMINAL_CODE=
QPAY_NOTE=Book borrow payment
